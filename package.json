{
	"name": "tsyntax",
	"version": "0.1.4",
	"publishConfig": {
		"access": "public"
	},
	"description": "A lightweight ~13 KB parser for scalar TypeScript-syntax DSL strings, validated at the type level and at runtime - one string, two walls",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"test": "tsc --noEmit && node --import=tsx/esm --test",
		"test:watch": "node --import=tsx/esm --test --watch"
	},
	"keywords": [
		"typescript",
		"dsl",
		"type-level",
		"type-safe",
		"validation",
		"runtime-validation",
		"template-literals",
		"parsing"
	],
	"author": "Sagi Carmel (https://github.com/AceCodePt)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AceCodePt/tsyntax.git"
	},
	"homepage": "https://www.npmjs.com/package/tsyntax",
	"packageManager": "pnpm@11.17.0",
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.1.2",
		"tsx": "^4.23.1"
	},
	"dependencies": {
		"typescript": "^7.0.2"
	}
}
