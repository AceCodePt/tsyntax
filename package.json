{
	"name": "tsyntax",
	"version": "1.1.3",
	"publishConfig": {
		"access": "public"
	},
	"description": "A lightweight ~17 KB parser for scalar TypeScript-syntax DSL strings, validated at the type level and at runtime - one string, two walls",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"test": "tsc --noEmit && node --import=tsx/esm --test",
		"test:package": "pnpm --filter tsyntax build && pnpm --filter @ace-code/tsyntax build && node scripts/verify-package.mjs",
		"test:watch": "node --import=tsx/esm --test --watch",
		"bench": "node bench/run.mjs",
		"bench:baseline": "node bench/run.mjs --save",
		"bench:light": "node bench/run.mjs --no-sweep"
	},
	"keywords": [
		"typescript",
		"dsl",
		"type-level",
		"type-safe",
		"validation",
		"runtime-validation",
		"template-literals",
		"parsing"
	],
	"author": "Sagi Carmel (https://github.com/AceCodePt)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AceCodePt/tsyntax.git"
	},
	"homepage": "https://www.npmjs.com/package/tsyntax",
	"packageManager": "pnpm@11.17.0",
	"devDependencies": {
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^26.1.2",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
