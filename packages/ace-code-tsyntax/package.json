{
	"name": "@ace-code/tsyntax",
	"version": "1.1.3",
	"publishConfig": {
		"access": "public"
	},
	"description": "Scoped alias for tsyntax - TypeScript-syntax DSL strings parsed at the type level and at runtime",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"test": "pnpm --filter tsyntax build && pnpm build && tsc --noEmit && node --import=tsx/esm --test"
	},
	"keywords": [
		"typescript",
		"dsl",
		"type-level",
		"validation"
	],
	"author": "Sagi Carmel (https://github.com/AceCodePt)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AceCodePt/tsyntax.git"
	},
	"homepage": "https://www.npmjs.com/package/@ace-code/tsyntax",
	"packageManager": "pnpm@11.17.0",
	"dependencies": {
		"tsyntax": "workspace:^"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
